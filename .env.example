# Copy to `.env` for local `netlify dev`, and set the same names/values in
# Netlify → Site settings → Environment variables for the deployed site.
# Never commit the real `.env` file — it's already in .gitignore.

# Dashboard → Developers → API keys. Use the sk_test_... key until you're
# ready to go live, then switch to the sk_live_... key.
STRIPE_SECRET_KEY=sk_test_...

# Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Dashboard → Product catalog → each product's Price ID (starts with price_).
STRIPE_PRICE_LOGO=price_...
STRIPE_PRICE_CAREPLAN=price_...

# The live site URL, no trailing slash. Used to build Stripe redirect URLs.
SITE_URL=https://mosslinedigital.ie
